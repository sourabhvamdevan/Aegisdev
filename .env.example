# ---- AegisDev configuration (copy to .env) ----
# All values have safe defaults; nothing here is a secret.

# Vector store location. ":memory:" is safe for ephemeral free-tier disks.
AEGISDEV_DB=:memory:

# Where uploaded/sample docs are written (ephemeral tmp is fine).
AEGISDEV_DATA=/tmp/aegisdev_data

# Embedding backend: auto | sentence-transformers | hashing
# auto -> use sentence-transformers if installed, else offline hashing.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Provider transparency shown in the UI: local | external
PROVIDER_MODE=local

# Security: comma-separated allowed CORS origins (no wildcard by default).
CORS_ORIGINS=http://localhost:8000

# Limits
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_PER_MINUTE=60

# Server
PORT=8000

# ---- Coding-agent patch generation ----
# builtin -> deterministic offline placeholder (default, zero-cost, CI-safe)
# ollama  -> local LLM via Ollama (privacy-first; requires a running Ollama)
PATCH_GENERATOR=builtin
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120

# Retrieval: hybrid (BM25 via SQLite FTS5 + vector, fused with RRF) | vector | lexical
RETRIEVAL_MODE=hybrid
